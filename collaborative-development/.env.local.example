# =========================================================================
#                    GOGODAM LOCAL CONFIGURATION TEMPLATE (.env.local.example)
# =========================================================================
# INSTRUCTIONS: Copy the contents of this file to a new file named `.env.local` 
# in the root of your project and fill in your custom keys.
# WARNING: Do NOT commit `.env.local` to git.

# -------------------------------------------------------------------------
# OpenRouter Configuration (Landing Chatbot AI)
# -------------------------------------------------------------------------
# The API key from OpenRouter (https://openrouter.ai/) to enable the landing page chatbot.
# If this is left empty, the chatbot will fall back to local rule-based matching.
OPENROUTER_API_KEY=your_openrouter_key_here

# The AI Model ID to request via OpenRouter. 
# Examples: meta-llama/llama-3.1-8b-instruct, google/gemini-2.5-flash, etc.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Optional: The domain of your site to display your application in OpenRouter's dashboard.
OPENROUTER_SITE_URL=http://localhost:3000

# Optional: The name of your application to display in OpenRouter's rankings.
OPENROUTER_APP_NAME="GoGodam Landing Chat"
